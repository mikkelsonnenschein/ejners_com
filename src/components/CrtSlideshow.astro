---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/hero-slides/*.{png,jpg,jpeg,webp,avif}',
	{ eager: true }
);

const images = Object.keys(imageModules)
	.sort()
	.map((path) => imageModules[path].default.src);
---

<div class:list={['crt-slideshow', className]}>
	<canvas data-crt-slideshow data-images={JSON.stringify(images)}></canvas>
</div>

<script src="../scripts/crtSlideshow.ts"></script>

<style>
	.crt-slideshow {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.crt-slideshow canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
