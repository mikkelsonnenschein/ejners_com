---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
// import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort((a, b) => {
  const yearA = Number(a.data.year) || 0;
  const yearB = Number(b.data.year) || 0;
  return yearB - yearA;
});

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<div class="header">
				<h1 class="accent">Ejner Seidelin</h1>
				<p class="accent tagline">Director · Cinematographer</p>
			</div>


			{
				posts.map((post) => (
					post.data.featured? post.data.video && (
						<video width="100%" height="auto" controls>
							<source src={post.data.video} type="video/mp4"/>	
						</video>					
									) : null
				))
			}


			<table>
				<thead>
				<tr>
					<th scope="col">Title</th>
					<th scope="col">Year</th>
					<th class="align-right" scope="col">Role</th>
				</tr>
				</thead>
				<tbody>
				{
					posts.map((post) => (
					<tr>
						<td>
							<a href={`/blog/${post.id}/`}>
								{post.data.title}
							</a>
						</td>
						<td class="accent-alt">{post.data.year}</td>
						<td class="align-right accent-alt">{post.data.role}</td>
					</tr>
					))
				}
				</tbody>
			</table>
  


			<!-- <section role="table" aria-label="List of films">
				<div role="rowgroup" class="table-header">
				<div role="columnheader">Title</div>
				<div role="columnheader">Year</div>
				<div role="columnheader">Role</div>
				</div>
			
				<div role="rowgroup" class="table-body">
				{
					posts.map((post) => (
					<div role="row" class="table-row">
						<div role="cell">
						<a href={`/blog/${post.id}/`} class="title-link">
							{post.data.title}
						</a>
						</div>
						<div role="cell">{post.data.year}</div>
						<div role="cell">{post.data.role}</div>
					</div>
					))
				}
				</div>
			</section> -->
  

		</main>
	</body>
</html>
