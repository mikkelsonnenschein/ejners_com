---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
// import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort((a, b) => {
  const yearA = Number(a.data.year) || 0;
  const yearB = Number(b.data.year) || 0;
  return yearB - yearA;
});

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<h1 class="accent">Ejner Seidelin</h1>
			<p class="accent">Director · Cinematographer</p>


			{
				posts.map((post) => (
					post.data.featured? post.data.video && (
						<video width="320" height="240" controls>
							<source src={post.data.video} type="video/mp4"/>	
						</video>					
									) : null
				))
			}



			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{/* {post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)} */}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">{post.data.year}</p>
									<p>{post.data.role}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>

		</main>
	</body>
</html>
