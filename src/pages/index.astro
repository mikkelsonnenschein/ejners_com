---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import CrtSlideshow from '../components/CrtSlideshow.astro';
import { getEntry, render } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
// import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

// Gets blog/about
const aboutPost = await getEntry('blog', 'about');

if (!aboutPost) {
   // Handle Error, for example:
  throw new Error('Could not find blog post 1');
}

// Rendering to allow for <Content />
const { Content, headings} = await render(aboutPost);

import chevronDown from '../assets/chevron-down.svg';
import playIcon from '../assets/play.svg';
import arrowRightIcon from '../assets/arrow-right.svg';
import profilePicture from '../assets/ejner-seidelin_profile-picture.png';

const BASE = import.meta.env.BASE_URL;


const sortableYear = (year?: string) => {
  if (year?.trim().toUpperCase() === 'TBA') return Infinity;
  return Number(year) || 0;
};

const posts = (await getCollection('blog')).sort((a, b) => {
  return sortableYear(b.data.year) - sortableYear(a.data.year);
});

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="crt-hero">
			<CrtSlideshow />
		</div>
		<Header/>
		<!-- <div class="header">
			<h1 class="accent">Ejner Seidelin</h1>
			<p class="accent tagline">Director · Cinematographer</p>
		</div> -->
		<main class="index-main">


			<!-- <div class="hero">
				{
				  posts.map((post) =>
					post.data.featured && post.data.video ? (
					  <div class="hero-item">
						<video width="auto" height="auto" controls>
						  {/* <source src={post.data.video} type="video/mp4" /> */}
						  <source src={aboutPost?.data.video} type="video/mp4" />
						</video>
						{/* <div class="hero-description">
						  <p class="accent-alt">~24mb</p>
						</div> */}
					  </div>
					) : null
				  )
				}
			  </div> -->


			<div class="table-wrapper">
				<table>
					<thead>
					<tr>
						<th scope="col" class="year-col">Year</th>
						<th scope="col" class="title-col">Title</th>
						<th scope="col" class="role-col">Role</th>
						<th scope="col"></th>
						<th scope="col" class="chevron-col"></th>
					</tr>
					</thead>
					<tbody>
						{
							posts
							  .filter((post) => post.data.title.toLowerCase() !== "about")
							  .map((post, index) => {
								const detailsId = `details-${index}`;
							
								return (
								  <>
								<tr
									class="toprow"
									role="button"
									tabindex="0"
									aria-expanded="false"
									aria-controls={detailsId}
								>
									<td class="year-cell accent-body">{post.data.year}</td>

									<td class="link-cell">
										{/* Mobile full-row link */}
										<a
										class="row-link"
										href={`${BASE}blog/${post.id}/`}
										aria-label={`Read more about ${post.data.title}`}
										/>

										<span class="toggle-btn accent-body">
										{post.data.title}
										</span>
									</td>

									<td class="accent-body">{post.data.role}</td>
									<td class="badge-cell accent-body">
										{post.data.ny && <span class="badge-new">New</span>}
										{post.data.upcoming && <span class="badge-upcoming">Upcoming</span>}
									</td>
									<td class="chevron-cell">
										<img class="chevron-icon" src={chevronDown.src} alt="" aria-hidden="true" />
									</td>
								</tr>
							
									{/* Content inside accordion */}
									<tr id={detailsId} hidden>
									  <td colspan="5">
										<div class="details-content">
										  <div class="details-content-container">
											<p>{post.data.description}</p>
											<a class="accent-alt underline bold" href={`${BASE}blog/${post.id}/${post.data.vimeoID ? '?autoplay=1' : ''}`}>
  												See more <span class="arrow">→</span>
											</a>
										  </div>

										  {post.data.still01 && (
											<a href={`${BASE}blog/${post.id}/${post.data.vimeoID ? '?autoplay=1' : ''}`} class="table-thumbnail-link" aria-label={`Read more about ${post.data.title}`}>
												<Image
												  class="table-thumbnail"
												  width={824}
												  height={460}
												  src={post.data.still01}
												  alt=""
												/>
												<img
												  class="table-thumbnail-play"
												  src={post.data.vimeoID ? playIcon.src : arrowRightIcon.src}
												  alt=""
												  aria-hidden="true"
												/>
											</a>
										  )}
										</div>
									  </td>
									</tr>
								  </>
								);
							  })
							}
							
							

					</tbody>
				</table>
			</div>
  
			<script>
				document.querySelectorAll<HTMLTableRowElement>(".toprow").forEach(row => {
				  const id = row.getAttribute("aria-controls");

				  if (!id) return; // safety guard

				  const content = document.getElementById(id);
				  if (!content) return;

				  const toggle = () => {
					const expanded = row.getAttribute("aria-expanded") === "true";
					row.setAttribute("aria-expanded", String(!expanded));
					content.hidden = expanded;
				  };

				  const isMobile = () => window.matchMedia("(max-width: 720px)").matches;

				  row.addEventListener("click", (event) => {
					const target = event.target as HTMLElement | null;
					// A real <a> in the row (e.g. .row-link) handles its own navigation.
					if (target?.closest("a")) return;

					if (isMobile()) {
					  // Whole row is tappable on mobile: navigate instead of toggling.
					  const href = row.querySelector<HTMLAnchorElement>(".row-link")?.getAttribute("href");
					  if (href) window.location.href = href;
					  return;
					}

					toggle();
				  });

				  row.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") {
					  event.preventDefault();
					  toggle();
					}
				  });
				});
				</script>
				
  
			<section id="about-section" class="about-section">
				<div class="about-wrapper">
					<div class="about-description">
						<!-- <h2 class="accent-alt">{aboutPost?.data.title}</h2> -->
						<h2 class="accent-alt">Bio</h2>
						<div id="bio-body" class="about-body">
							<Content />
						</div>
					</div>
					<div class="about-links">
						<h2 class="accent-alt">Contact</h2>
						<div class="about-link-list">
							<img src={profilePicture.src} alt="">
							<!-- <a href={aboutPost?.data.externalLink01} class="accent-alt">{aboutPost?.data.externalLink01text}<span> ↗</span></a> -->
							<a href={aboutPost?.data.externalLink02} class="accent-alt">{aboutPost?.data.externalLink02text}<span> ↗</span></a>
							<!-- <a href={aboutPost?.data.externalLink03} class="accent-alt">{aboutPost?.data.externalLink03text}<span> ↗</span></a>							 -->
							<div class="about-body accent-alt">ejner.seidelin@gmail.com</div>
						</div>
					</div>
				</div>
			</section>

			<script>
				document.querySelectorAll("#bio-body p").forEach((p) => {
				  const lines = (p.textContent ?? "")
					.split("\n")
					.map((line) => line.trim())
					.filter(Boolean);

				  if (lines.length <= 1) return;

				  const frag = document.createDocumentFragment();
				  lines.forEach((line) => {
					const newP = document.createElement("p");
					newP.textContent = line;
					frag.appendChild(newP);
				  });
				  p.replaceWith(frag);
				});
				</script>

		</main>
	</body>
</html>
