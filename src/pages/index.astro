---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { getEntry, render } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
// import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

// Gets blog/about
const aboutPost = await getEntry('blog', 'about');

if (!aboutPost) {
   // Handle Error, for example:
  throw new Error('Could not find blog post 1');
}

// Rendering to allow for <Content />
const { Content, headings} = await render(aboutPost);

// Import the base from Astro configuration
import config from '../../astro.config.mjs';
const BASE = config.base || '/';


const posts = (await getCollection('blog')).sort((a, b) => {
  const yearA = Number(a.data.year) || 0;
  const yearB = Number(b.data.year) || 0;
  return yearB - yearA;
});

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header/>
		<!-- <div class="header">
			<h1 class="accent">Ejner Seidelin</h1>
			<p class="accent tagline">Director · Cinematographer</p>
		</div> -->
		<main>


			<!-- <div class="hero">
				{
				  posts.map((post) =>
					post.data.featured && post.data.video ? (
					  <div class="hero-item">
						<video width="auto" height="auto" controls>
						  {/* <source src={post.data.video} type="video/mp4" /> */}
						  <source src={aboutPost?.data.video} type="video/mp4" />
						</video>
						{/* <div class="hero-description">
						  <p class="accent-alt">~24mb</p>
						</div> */}
					  </div>
					) : null
				  )
				}
			  </div> -->


			<div class="hero">
				<div class="hero-item">
					<video width="auto" height="auto" controls>
					  	<source src={aboutPost?.data.video} type="video/mp4" />
					</video>
				</div>
			</div>
			  

			<div class="table-wrapper">
				<table>
					<thead>
					<tr>
						<th scope="col" class="title-col">Title</th>
						<th scope="col">Year</th>
						<th scope="col" class="role-col">Role</th>
						<th class="align-right" scope="col"></th>
					</tr>
					</thead>
					<tbody>
						{
							posts
							  .filter((post) => post.data.title.toLowerCase() !== "about")
							  .map((post, index) => {
								const detailsId = `details-${index}`;
							
								return (
								  <>
									<tr class="toprow">
									  <td>
										<button
										  class="toggle-btn accent-body"
										  aria-expanded="false"
										  aria-controls={detailsId}
										>
										  {post.data.title}
										  <span class="visually-hidden">
											Toggle details for {post.data.title}
										  </span>
										</button>
									  </td>
							
									  <td class="accent-body">{post.data.year}</td>
									  <td class="accent-accent-body">{post.data.role}</td>
									  <td class="badge-cell align-right accent-body">
										{post.data.ny? <span class="badge-new">New</span> : null}
										{post.data.upcoming? <span class="badge-upcoming">Upcoming</span> : null}
									  </td>
									</tr>
							
									{/* Content inside accordion */}
									<tr id={detailsId} hidden>
									  <td colspan="4">
										<div class="details-content">
										  <div class="details-content-container">
											<p>{post.data.description}</p>
											<a
											  class="accent-alt underline bold"
											  href={`${BASE}blog/${post.id}/`}
											>
											  Read more <span class="arrow">→</span>
											</a>
										  </div>
							
										  {post.data.still01 && (
											<Image
											  class="table-thumbnail"
											  width={824}
											  height={460}
											  src={post.data.still01}
											  alt=""
											/>
										  )}
										</div>
									  </td>
									</tr>
								  </>
								);
							  })
							}
							
							

					</tbody>
				</table>
			</div>
  
			<script>
				document.querySelectorAll(".toggle-btn").forEach(button => {
				  button.addEventListener("click", () => {
					const expanded =
					  button.getAttribute("aria-expanded") === "true";
				
					const id = button.getAttribute("aria-controls");
				
					if (!id) return; // safety guard
				
					const content = document.getElementById(id);
					if (!content) return;
				
					button.setAttribute("aria-expanded", String(!expanded));
					content.hidden = expanded;
				  });
				});
				</script>
				
  
			<section id="about-section" class="about-section">
				<div class="about-wrapper">
					<div class="about-description">
						<!-- <h2 class="accent-alt">{aboutPost?.data.title}</h2> -->
						<h2 class="accent-alt">About</h2>
						<div class="about-body">
							<Content />
						</div>
					</div>
					<div class="about-links">
						<h2 class="accent-alt">Links</h2>
						<div class="about-link-list">
							<a href={aboutPost?.data.externalLink01} class="accent-alt">{aboutPost?.data.externalLink01text}<span> ↗</span></a>
							<a href={aboutPost?.data.externalLink02} class="accent-alt">{aboutPost?.data.externalLink02text}<span> ↗</span></a>
							<a href={aboutPost?.data.externalLink03} class="accent-alt">{aboutPost?.data.externalLink03text}<span> ↗</span></a>
						</div>
					</div>
				</div>
			</section>

		</main>
	</body>
</html>
